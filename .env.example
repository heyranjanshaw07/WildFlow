# WindScope Environment Configuration Example
# Copy to .env for local adjustments

# Backend Configuration
APP_NAME="WindScope — UK Wind Forecast Intelligence Platform"
ENVIRONMENT=production
CUTOFF_HOUR=9
CUTOFF_MINUTE=0
CUTOFF_TIMEZONE=Europe/London
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173","http://localhost:80","http://localhost"]

# Frontend Configuration
# Leave empty for dev proxy or Docker Nginx reverse proxy
# Set to full origin (e.g. https://your-backend.onrender.com) for split deployments
VITE_API_BASE_URL=
